# ==========================================================================
# backend bbbrindes (Payload CMS). Copie para .env e preencha com valores
# reais LOCAIS. NUNCA commitar o .env (CLAUDE.md regra 14). Valores abaixo
# sao ficticios so para documentar o formato.
# ==========================================================================

# Postgres (Supabase). Duas formas; escolha UMA.
#
# Recomendado: parametros SEPARADOS. Se PGHOST estiver definido, o backend usa
# estes e ignora DATABASE_URI. A senha vai crua, sem percent-encode. Em rede sem
# IPv6, use o Session pooler (host aws-0-<regiao>.pooler.supabase.com, porta
# 5432, user postgres.<ref>) -- ver Project Settings > Database > Connection
# parameters. O pooler e IPv4; a conexao direta (db.<ref>.supabase.co) e IPv6.
PGHOST=aws-0-us-east-2.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.xxxxxxxxxxxx
PGPASSWORD=sua-senha-crua-aqui
PGDATABASE=postgres

# Alternativa: connection string unica (so e usada se PGHOST estiver vazio).
# Cuidado: senha com caractere especial precisa de percent-encode.
# DATABASE_URI=postgresql://postgres.xxxx:senha@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Segredo do Payload (chave de assinatura de sessao/JWT). Gere um valor
# aleatorio, ex.: `openssl rand -hex 32`. Trocar por um valor proprio.
PAYLOAD_SECRET=troque-por-um-valor-aleatorio-de-32-bytes

# URL publica do backend (admin e API). Dev: http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Origem do frontend (site) que loga o revendedor via API. Libera CORS/CSRF.
# Dev: http://localhost:3000. Prod: dominio do site (ex.: https://bbbrindes.com.br).
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Cloudflare R2 (S3-compativel) para os uploads de imagem.
# Deixe S3_BUCKET vazio em dev para usar disco local (sem R2).
# Preencha em homologacao/producao. Endpoint no formato:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# --------------------------------------------------------------------------
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
