{
  "name": "bbbrindes",
  "private": true,
  "version": "0.2.0",
  "description": "Plataforma B2B de brindes corporativos: catalogo, orcamento e area de revendedor.",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter backend build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "start": "pnpm --filter backend start:railway",
    "start:frontend": "pnpm --filter frontend start",
    "lint": "pnpm --filter frontend lint",
    "trello:sync": "node --env-file=.env scripts/trello-sync.mjs"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
